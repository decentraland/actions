{
  "name": "@dcl/cdn-deploy-action",
  "version": "1.0.0",
  "private": true,
  "description": "Build-folder -> S3 -> Cloudflare KV rollout in a single GitHub Action (OIDC for AWS).",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "all": "npm run build && npm test"
  },
  "license": "Apache-2.0",
  "prettier": {
    "printWidth": 100,
    "semi": true
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^5.1.1",
    "@dcl/cdn-uploader": "^1.5.0",
    "@well-known-components/rollouts-lib": "^1.0.0",
    "aws-sdk": "^2.1692.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/node-fetch": "^2.6.11",
    "@vercel/ncc": "^0.38.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
