{
  "name": "@dcl/cdn-deploy-action",
  "version": "1.0.0-4242.commit-abc1234",
  "private": true,
  "description": "Build-folder -> S3 -> Cloudflare KV rollout in a single GitHub Action (OIDC for AWS).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "all": "npm run typecheck && npm run format:check && npm run test:coverage && npm run build"
  },
  "license": "Apache-2.0",
  "prettier": {
    "printWidth": 100,
    "semi": true
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@dcl/cdn-uploader": "^1.5.0",
    "aws-sdk": "^2.1692.0",
    "node-fetch": "^3.3.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.6.11",
    "@types/semver": "^7.8.0",
    "@vercel/ncc": "^0.38.1",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
